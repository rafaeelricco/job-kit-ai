{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "..",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "node"],

    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"],
      "@api/*": ["./src/api/*"],
      "@be/*": ["../backend/src/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@lib/*": ["../lib/*"],
      "@module/*": ["./src/module/*"],
      "@pages/*": ["./src/pages/*"],
      "@ui/*": ["./src/components/ui/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../backend/src", "../lib"]
}
