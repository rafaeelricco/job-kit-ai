{
  "name": "@job-kit/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.prod.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "lint": "eslint .",
    "compose": "docker compose -f development/compose.yaml -f development/compose.dev.yaml",
    "up": "pnpm compose up --build -d --wait --remove-orphans",
    "down": "pnpm compose down",
    "test:unit": "vitest run tests/unit",
    "test:regression": "vitest run tests/regression",
    "test:coverage": "vitest run --coverage",
    "test:coverage:all": "vitest run --config tests/quality/vitest.all.config.ts --coverage",
    "test:mutation": "stryker run tests/quality/stryker.config.mjs",
    "quality": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:coverage",
    "quality:report": "tsx tests/quality/report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.90.0",
    "@job-kit/lib": "workspace:*",
    "@paralleldrive/cuid2": "3.3.0",
    "express": "4.22.2",
    "google-auth-library": "11.1.0",
    "js-sha256": "0.11.1",
    "luxon": "3.7.2",
    "mongodb": "5.9.2",
    "nodemailer": "^10.0.12",
    "openai": "6.34.0",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/express": "4.17.25",
    "@types/luxon": "3.7.1",
    "@types/node": "24.12.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.4",
    "eslint-plugin-sonarjs": "4.0.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.11"
  }
}
