# Optional: copy to development/.env to change the host API port.
API_PORT=3010
# Keep the selected generation stable across restarts.
POSTIE_GENERATION=1
# Shared only between the API's server-side proxy and the postie container.
ENGINE_OPERATOR_TOKEN=change-me
# Database/event-bus credentials in Compose and application.yaml are local examples.
# The note API requires a signed-in session; /api/dev/engine stays unauthenticated, on loopback only.

# Where the SPA lives. The Google redirect URI is this origin + /api/v1/auth/google/callback.
APP_URL=http://localhost:5173/jobs/
# Google OAuth web client. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# smtps://user:pass@host:465. Empty prints login codes to the API log instead of sending mail.
SMTP_URL=
MAIL_FROM=Job Kit <login@localhost>
# Key for hashing stored login codes (openssl rand -hex 32). Empty uses a fixed development key; production refuses to start without it.
LOGIN_CODE_SECRET=
