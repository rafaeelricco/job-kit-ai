{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "@be/*": ["./src/*"],
      "@lib/*": ["../lib/*"],
      "@tests/*": ["./tests/*"]
    },
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "checkJs": true,
    "sourceMap": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": ["src", "tests", "vitest.config.ts", "../lib"]
}
